[2026-09-21 23:25:22.977] ############ Table name or SQL Query : (select s1.startdate as STARTDATE, 
s1.loc AS LOC, s1.item AS ITEM, AVG(s2.totdmd) AS AVG_TOTDMD
from UDTM_SKUPROJSTATIC s1
left join UDTM_SKUPROJSTATIC s2 on s2.item = s1.item and s2.loc = s1.loc and (
    s2.startdate between s1.startdate + 7 and s1.startdate + 62)
where s1.optionset = 'eitmi'
and s2.optionset = 'eitmi'
and s1.STARTDATE >= TRUNC(SYSDATE, 'IW')
AND s1.STARTDATE <= TRUNC(SYSDATE + 196, 'IW')
group by s1.item, s1.loc, s1.startdate) SRC 
