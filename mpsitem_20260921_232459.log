(select TRUNC(SYSDATE, 'IW') from dual) as MINSTARTDATE,
s2.altconstrpoh as LASTWEEKS_CALCOH, 
s2.schedrcpts as LASTWEEKS_SCHEDRCPTS,
 s2.PlanOrders as LASTWEEKS_PLANORDERS, s2.FirmPlanOrder as LASTWEEKS_FIRMPLANORDER, 
s2.RecArriv as LASTWEEKS_RECARRIV, 
s2.TotInTransIn as LASTWEEKS_TOTINTRANSIN
FROM
 UDTM_SKUPROJSTATIC 
left join UDTM_SKUPROJSTATIC s2 on s2.item = UDTM_SKUPROJSTATIC.item and s2.loc = UDTM_SKUPROJSTATIC.loc and (s2.startdate) = UDTM_SKUPROJSTATIC.startdate - 7
WHERE 
UDTM_SKUPROJSTATIC.STARTDATE >= TRUNC(SYSDATE, 'IW')
AND UDTM_SKUPROJSTATIC.STARTDATE <= TRUNC(SYSDATE + 196, 'IW')
AND UDTM_SKUPROJSTATIC.OPTIONSET = 'eitmi') SRC 
