[2026-09-21 23:25:23.208] ############ Table name or SQL Query : (select textval as TargetPLevel,
MAX(DECODE(TargetName, 'GLOBAL_BO_TARGET', numval)) AS GLOBAL_BO_TARGET,
MAX(DECODE(TargetName, 'GLOBAL_LIFR_IMPACT_TARGET', numval)) AS GLOBAL_LIFR_IMPACT_TARGET,
MAX(DECODE(TargetName, 'GLOBAL_LIFR_TARGET', numval)) AS GLOBAL_LIFR_TARGET,
MAX(DECODE(TargetName, 'GLOBAL_LINES_ORDER', numval)) AS GLOBAL_LINES_ORDER
from 
(
    SELECT
    textval,
    case when name like 'GLOBAL_BO_TARGET_%' then 'GLOBAL_BO_TARGET' 
        when name like 'GLOBAL_LIFR_IMPACT_TARGET_%' then 'GLOBAL_LIFR_IMPACT_TARGET' 
        when name like 'GLOBAL_LIFR_TARGET_%' then 'GLOBAL_LIFR_TARGET' 
        when name like 'GLOBAL_LINES_ORDER_%' then 'GLOBAL_LINES_ORDER' end as TargetName,
    numval
    from uprm_options
    where param = 'CSS_CONTROL_TOWER'
    and textval <> 'P5_ASP'
) x
GROUP BY x.textval
ORDER BY x.textval) SRC 
