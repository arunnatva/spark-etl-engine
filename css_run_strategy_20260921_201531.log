[2026-09-21 20:15:54.128] ############ Table name or SQL Query : (select res, rescal,
max ( case when CalType = 'STAFF' THEN AVAIL END) StaffCap,
max ( case when CalType = 'STAFF' THEN caplinehour END) StaffCap_CapLineHour,
max ( case when CalType = 'INST' THEN AVAIL END) InstCap,
max ( case when CalType = 'LE' THEN AVAIL END) LeCap,
max ( case when CalType = 'BP' THEN AVAIL END) BpCap
from (
    SELECT maxcal.res, maxcal.rescal as rescal, cd.cal,
    cd.AVAIL,
    case when cd.urep_caplinehour is null then 0 else cd.urep_caplinehour end as caplinehour,
    case
        when cal like '%_STAF' then 'STAFF'
        when cal like '%_INST' then 'INST'
        when cal like '%_BP' then 'BP'
        when cal like '%_LE' then 'LE'
        else 'NA' END as CalType
    from
    (
        select res, r.cal as rescal, c.cal as caldataCal, max(EFF) as maxeff
        FROM SCPOMGR.CALDATA c, res r
        where (c.cal = r.cal || '_BP'
        or c.cal = r.cal || '_STAF'
        or c.cal = r.cal || '_LE'
        OR c.cal = r.cal || '_INST')
        group by res, r.cal, c.cal
    ) maxCal
    inner join caldata cd on maxcal.caldataCal = cd.cal and maxcal.maxeff = cd.eff
)x
group by res, rescal) SRC 
