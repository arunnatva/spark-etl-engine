 UDTM_SKUPROJSTATIC
 inner join item i on UDTM_SKUPROJSTATIC.item = i.item and i.usys_h1_level5 <> 'P5_ASP'
WHERE 
UDTM_SKUPROJSTATIC.STARTDATE >= TRUNC(SYSDATE, 'month')
AND UDTM_SKUPROJSTATIC.STARTDATE <= TRUNC(SYSDATE + 730, 'month')
AND UDTM_SKUPROJSTATIC.OPTIONSET = 'eitmi') SRC 
