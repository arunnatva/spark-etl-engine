[2026-09-20 04:10:54.372] ############ Table name or SQL Query : (select DATEVAL, MONTHNUM, YEARNUM, CALNAME, NEWEFF, AVAIL, RES, AVAIL2, NextDateVal
    from (
        select y.dateval,
        to_char(y.dateval, 'MM') as MonthNum ,
        to_char(y.dateval, 'YYYY') as YearNum,    
        x2.Neweff, x2.res, x2.avail, x2.calDataCal as calname,
        avail2, NextDateVal
        from (
            select x.dateval,
            case when mod(rownum, 7) <= (7 -2) and mod(rownum, 7)  <> 0 then 1 else 0 end as PatternDay ,
            rownum as rownumber--,
            from (  
                select TRUNC(SYSDATE, 'MM')  + rownum - 1 as dateval
                FROM DUAL d  
                CONNECT BY ROWNUM < 730
            ) x
        ) y
        left join (
            select r.res, r.loc, r.cal as resCal, c.master,
            cd.cal as calDataCal, (TO_DATE('01-JAN-1970', 'DD-MON-YYYY')+(cd.EFF/1440)) AS NEWEFF, cd.avail,
            (
                select avail as avail2
                from caldata cd2
                where cd2.CAL = cd.cal
                and cd2.eff = (select min(eff) from caldata cd3 where cd3.cal = cd.cal and cd3.eff > cd.eff)
            ) avail2,
            (
                select (TO_DATE('01-JAN-1970', 'DD-MON-YYYY')+(EFF/1440)) as dateval2
                from caldata cd2
                where cd2.CAL = cd.cal
                and cd2.eff = (select min(eff) from caldata cd3 where cd3.cal = cd.cal and cd3.eff > cd.eff)               
            ) NextDateVal
            from res r
            inner join cal c on r.cal = c.cal
            inner join caldata cd on c.cal = cd.cal          
            --where (TO_DATE('01-JAN-1970', 'DD-MON-YYYY')+(cd.EFF/1440)) >= TRUNC(sysdate, 'MONTH')
        ) x2 on 1=1
        order by y.rownumber
    ) WorkingDays
    where WorkingDays.dateval >= TRUNC(sysdate, 'MONTH')) SRC 
