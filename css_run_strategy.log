[2026-09-20 01:13:12.496] ############ Table name or SQL Query : (select DATEVAL, MONTHNUM, YEARNUM, PATTERNDAY, resCal, res, loc,
((min(UpdatedActiveDay)) * (case when dateval < startofweek then 0 else 1 end)) as NonPatternDay
from (
    select DATEVAL, FinancialMonth as MonthNum, FinancialYear as YearNum, PATTERNDAY, resCal, NEWEFF, OPT, res,
        case when (dateval = neweff and opt = 1) then 0 else 1 end as activeDay,
        DaysClosed, case when DaysClosed > 0 then 0 else 1 end as UpdatedActiveDay,
        trunc(sysdate, 'IW') as StartOfWeek, loc
    from (
        select dateval, patternday,
        case when FiMo Is Null then MonthNum
            else FiMo end as FinancialMonth,
        case when FiMo = 1 and monthnum = 12 then yearnum + 1
                   when FiMo = 12 and monthnum = 1 then yearnum - 1
            else yearnum end as FinancialYear,
        x2.resCal, x2.Master_CalData,
        x2.Neweff, x2.opt, x2.repeat, x2.res, x2.loc,
        case when dateval >= neweff then (reopeneddate - dateval) else 0 end as DaysClosed
        from (
            select calendardate as dateval, patternday,
            mod(sum(DateType) OVER (
              ORDER BY CalendarDate
              ROWS BETWEEN UNBOUNDED preceding AND CURRENT ROW
            ) + to_number(to_char(NEXT_DAY(TRUNC(sysdate, 'MM'),'Mon') -21, 'MM')) -1 ,12) +1 as FiMo,
            MonthNum ,
            YearNum
            from (
             select x.CalendarDate,
                case when mod(rownum, 7) <= (7 -2) and mod(rownum, 7)  <> 0 then 1 else 0 end as PatternDay-- ,
                ,to_number(to_char(x.calendardate, 'MM')) as MonthNum ,
                to_number(to_char(x.calendardate, 'YYYY')) as YearNum--,
                , (
                    select
                    CASE WHEN DESCR = 'Y_N_N' THEN 1
                        WHEN DESCR = 'Y_Y_N' THEN 1
                        WHEN DESCR = 'Y_Y_Y' THEN 1
                        ELSE 0 END
                    from
                    (
                        select *
                        from caldata cd2
                        where cal = 'REP_CSS_CONTROLTOWER'
                    ) x
                        where TO_DATE('01-JAN-1970', 'DD-MON-YYYY')+(x.EFF/1440) = x.calendardate
                ) DateType
                from (
                    select trunc(next_day(TRUNC(sysdate, 'MM'),'Mon') - 21,'IW')  + rownum - 1 as CalendarDate
                    FROM DUAL d
                  CONNECT BY ROWNUM < 730
                ) x
            ) CalendarData
        ) z
        left join (
                    select r.res, r.loc, r.cal as resCal, c.master,
                    cd.cal as Master_CalData, (TO_DATE('01-JAN-1970', 'DD-MON-YYYY')+(EFF/1440)) AS NEWEFF, OPT, REPEAT, TO_NUMBER(Repeat) / 1440 as PatternLength,
                    case when opt = 1 then
                    (
                            select TO_DATE('01-JAN-1970', 'DD-MON-YYYY')+(cd2.EFF/1440) as ReopenedDate
                            from caldata cd2
                            where cd2.cal = cd.cal
                            and cd2.eff = (select min(eff) from caldata cd3 where cd3.cal = cd.cal and cd3.eff > cd.eff)
                        )  Else NULL end as ReopenedDate
                    from res r
                    inner join cal c on r.cal = c.cal
                    inner join caldata cd on c.master = cd.cal
                    where opt <> 6 --and (TO_DATE('01-JAN-1970', 'DD-MON-YYYY')+(EFF/1440)) >= TRUNC(sysdate - 60, 'MM')
                ) x2 on 1=1
    )WorkingDays
    where WorkingDays.dateval >= (select max(TO_DATE('01-JAN-1970', 'DD-MON-YYYY')+(cd2.EFF/1440))
                                    from caldata cd2
                                    where cal = 'REP_CSS_CONTROLTOWER'
                                    and TO_DATE('01-JAN-1970', 'DD-MON-YYYY')+(cd2.EFF/1440) < TRUNC(sysdate, 'MM'))
)wResult
group by DATEVAL, MONTHNUM, YEARNUM, PATTERNDAY, resCal, startofweek, res, loc
order by dateval) SRC
