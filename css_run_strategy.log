    inner join sku s on x1.item = s.item and x1.loc = s.loc
    inner join res r on r.res = s.urep_mfgclscode
    group by r.res, x1.loc
) maxLead
inner join sku s2 on maxlead.loc = s2.loc
inner join item i2 on s2.item = i2.item and i2.usys_h1_level5 <> 'P5_ASP') SRC
