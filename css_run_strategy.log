[2026-09-20 01:13:13.124] ############ Table name or SQL Query : (select maxlead.res,  i2.item, maxlead.loc, maxlead.maxLeadTime as mfgleadtime, ((maxlead.MaxLeadTime)/1440) + TRUNC(sysdate, 'iw') as LeadTime_EndDate
from (
    select
    r.res,
    x1.loc,
    max(mfgleadtime) as maxLeadTime
    from
    (
        select s.item, s.loc, s.mfgleadtime
        from skuplanningparam s
